# Bản mẫu chạy native eduerp-mcp trên máy dev (copy thành eduerp-mcp/.env)
HOST=0.0.0.0
PORT=8700
PUBLIC_URL=http://localhost:8090

# Kết nối chung PostgreSQL & Redis với DS Academy Backend
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduerp
DB_USERNAME=agent
DB_PASSWORD=localdev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URL nội bộ gọi sang Spring Boot Backend
EDUERP_API_BASE_URL=http://localhost:8080

# Phải khớp với IDENTITY_JWT_SECRET bên backend/.env để xác thực cookie phiên eduerp_at
IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes

# Khóa niêm phong OAuth 2.1 Authorization Code / Access Token / Refresh Token (tối thiểu 32 bytes)
MCP_SEALER_SECRET=dev-only-mcp-sealer-secret-key-must-be-at-least-32-bytes

# Proxy, CORS & OAuth Redirect Whitelist (Claude, ChatGPT, Local MCP Client)
ALLOWED_ORIGINS=*
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
ALLOWED_REDIRECT_HOSTS=claude.ai,anthropic.com,chatgpt.com,chat.openai.com,openai.com,localhost,127.0.0.1
ALLOWED_REDIRECT_PREFIXES=claude.ai/api/mcp/auth_callback,chatgpt.com/connector_platform_oauth_redirect,chat.openai.com/connector_platform_oauth_redirect
AUTO_ENSURE_SCHEMA=true
