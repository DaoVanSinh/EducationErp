# Bản mẫu cho container eduerp-mcp trong docker-compose.prod.yml (copy thành eduerp-mcp/.env.docker.prod)
HOST=0.0.0.0
PORT=8700
PUBLIC_URL=https://dsacademy.edu.vn

DB_HOST=postgres
DB_PORT=5432
DB_NAME=eduerp
DB_USERNAME=eduerp_app
DB_PASSWORD=DsAcademyProdDbPass2026!Secure

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=DsAcademyProdRedisPass2026!Secure

EDUERP_API_BASE_URL=http://app:8080

# Khớp với IDENTITY_JWT_SECRET trong backend/.env.docker.prod
IDENTITY_JWT_SECRET=ds-academy-prod-jwt-secret-key-at-least-48-bytes-long-2026
MCP_SEALER_SECRET=ds-academy-prod-mcp-sealer-secret-key-48-bytes-long-2026

ALLOWED_ORIGINS=*
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
ALLOWED_REDIRECT_HOSTS=claude.ai,anthropic.com,chatgpt.com,chat.openai.com,openai.com,localhost,127.0.0.1
ALLOWED_REDIRECT_PREFIXES=claude.ai/api/mcp/auth_callback,chatgpt.com/connector_platform_oauth_redirect,chat.openai.com/connector_platform_oauth_redirect
AUTO_ENSURE_SCHEMA=true
