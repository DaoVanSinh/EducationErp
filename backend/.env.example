
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduerp
DB_USERNAME=agent
DB_PASSWORD=localdev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (Gmail) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Identity ---
IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes
IDENTITY_SECURE_COOKIES=true

#--- Admin ---
IDENTITY_DEFAULT_ADMIN_EMAIL=admin@eduerp.local
IDENTITY_DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Storage (S3-compatible; trống = AWS S3 thật, có giá trị = MinIO/S3-compatible tự host) ---
# Máy dev đã có container agent-minio dùng chung (cổng 9010/9011, xem docker ps) - không dựng thêm.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eduerp-contracts
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
