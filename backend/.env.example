# Bản mẫu biến môi trường cho backend. Copy thành .env rồi điền giá trị thật — .env đã bị gitignore.
#
# Spring Boot KHÔNG tự đọc file .env (khác Node/Vite ở frontend). Trước khi chạy
# `mvn spring-boot:run`, nạp file này vào shell:
#
#   export $(grep -v '^#' .env | xargs)
#
# Giá trị mặc định dưới đây khớp với backend/compose.yaml (`docker compose up`) và với giá trị
# ${VAR:default} đang có trong src/main/resources/application.yml — để trống hoặc xoá dòng nào thì
# app chạy đúng bằng default đó, không cần .env cũng chạy được ở local.

# --- PostgreSQL (khớp backend/compose.yaml) ---
DB_USERNAME=eduerp
DB_PASSWORD=eduerp

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (mặc định trỏ vào MailHog của compose.yaml, xem mail ở http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Identity ---
# Bí mật ký JWT. Giá trị mặc định CHỈ dùng để chạy local — môi trường thật bắt buộc phải đặt
# một chuỗi ngẫu nhiên riêng, tối thiểu 32 byte.
IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes
# Cookie phiên gắn cờ Secure — bật ở mọi môi trường thật. Chỉ tắt khi chạy local qua http và trình
# duyệt từ chối cookie Secure trên kết nối không TLS.
IDENTITY_SECURE_COOKIES=true
# Tài khoản Admin mặc định: hệ thống tự dựng lại tài khoản này mỗi khi không còn Admin nào (xem
# SeedDefaultAdmin). Môi trường thật PHẢI đặt mật khẩu riêng, không dùng giá trị mặc định.
IDENTITY_DEFAULT_ADMIN_EMAIL=admin@eduerp.local
IDENTITY_DEFAULT_ADMIN_PASSWORD=ChangeMe123!
