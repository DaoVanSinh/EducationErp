# Bản mẫu biến môi trường cho backend. Copy thành .env rồi điền giá trị thật — .env đã bị gitignore.
#
# Spring Boot KHÔNG tự đọc file .env (khác Node/Vite ở frontend). Trước khi chạy
# `mvn spring-boot:run`, nạp file này vào shell:
#
#   export $(grep -v '^#' .env | xargs)
#
# Giá trị mặc định dưới đây khớp với default ${VAR:...} đang có trong
# src/main/resources/application.yml — để trống hoặc xoá dòng nào thì app chạy đúng bằng default đó.
# Không còn compose.yaml riêng cho eduerp: Postgres/Redis dùng chung container dev sẵn có trên máy.

# --- PostgreSQL ---
# Container dev dùng chung nhiều dự án (agent-postgres, cổng 5433) — database "eduerp" đã tạo sẵn
# trong đó, owner là user agent. Nếu máy bạn không có container này, đổi 4 dòng dưới cho khớp
# Postgres bạn đang dùng.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduerp
DB_USERNAME=agent
DB_PASSWORD=localdev

# --- Redis ---
# redis-stack sẵn có trên máy, cổng mặc định 6379 — không cần đổi nếu bạn dùng đúng container đó.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (Gmail) ---
# Không có container bắt mail local nào sẵn, nên dùng thẳng SMTP Gmail. MAIL_PASSWORD PHẢI là App
# Password (myaccount.google.com > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng), không phải mật
# khẩu đăng nhập Gmail thường — Gmail chặn SMTP AUTH bằng mật khẩu thường.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Identity ---
# Bí mật ký JWT. Giá trị mặc định CHỈ dùng để chạy local — môi trường thật bắt buộc phải đặt
# một chuỗi ngẫu nhiên riêng, tối thiểu 32 byte.
IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes
# Cookie phiên gắn cờ Secure — bật ở mọi môi trường thật. Chỉ tắt khi chạy local qua http và trình
# duyệt từ chối cookie Secure trên kết nối không TLS.
IDENTITY_SECURE_COOKIES=true
# Tài khoản Admin mặc định: hệ thống tự dựng lại tài khoản này mỗi khi không còn Admin nào (xem
# SeedDefaultAdmin). Môi trường thật PHẢI đặt mật khẩu riêng, không dùng giá trị mặc định.
IDENTITY_DEFAULT_ADMIN_EMAIL=admin@eduerp.local
IDENTITY_DEFAULT_ADMIN_PASSWORD=ChangeMe123!
