# Bản mẫu chạy native DS Academy Backend trên máy dev (copy thành backend/.env)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduerp
DB_USERNAME=agent
DB_PASSWORD=localdev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SMTP (Gmail) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hoangdieu224466@gmail.com
MAIL_PASSWORD=

# --- Identity & Security ---
IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes
IDENTITY_SECURE_COOKIES=true
IDENTITY_MAIL_FROM=no-reply@dsacademy.edu.vn
IDENTITY_FRONTEND_RESET_URL=http://localhost:8090/reset-password

# --- Tài khoản Admin mặc định ---
IDENTITY_DEFAULT_ADMIN_EMAIL=admin@eduerp.local
IDENTITY_DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Storage (MinIO S3-compatible trên máy dev) ---
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eduerp-contracts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- CORS & Edge Proxy ---
CORS_ALLOWED_ORIGINS=*
EDGE_SERVER_NAME=_
BIND_ADDRESS=0.0.0.0
HOST_PORT=8090

# --- MCP Gateway ---
MCP_PUBLIC_URL=http://localhost:8090
MCP_SEALER_SECRET=dev-only-mcp-sealer-secret-key-must-be-at-least-32-bytes
