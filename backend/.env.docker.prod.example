# Bản mẫu cho docker-compose.prod.yml (server thật). Copy thành backend/.env.docker.prod rồi điền
# giá trị thật — đã bị gitignore. KHÔNG dùng lại giá trị mặc định nào ở đây, kể cả để test nhanh.
#
# Không khai DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT — docker-compose.prod.yml tự trỏ hai cái đó vào
# service postgres/redis của chính stack, không đọc từ file này.

DB_NAME=eduerp
DB_USERNAME=eduerp_app
DB_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Bắt buộc một chuỗi ngẫu nhiên riêng, tối thiểu 32 byte — không dùng giá trị dev-only-secret-*.
IDENTITY_JWT_SECRET=
IDENTITY_SECURE_COOKIES=true
IDENTITY_MAIL_FROM=no-reply@eduerp.local
# Domain thật của frontend, không phải localhost.
IDENTITY_FRONTEND_RESET_URL=https://eduerp.example.com/reset-password

IDENTITY_DEFAULT_ADMIN_EMAIL=
IDENTITY_DEFAULT_ADMIN_PASSWORD=
