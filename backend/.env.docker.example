# Bản mẫu cho docker-compose.yml (copy thành backend/.env.docker)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=eduerp
DB_USERNAME=agent
DB_PASSWORD=localdev

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hoangdieu224466@gmail.com
MAIL_PASSWORD=

IDENTITY_JWT_SECRET=dev-only-secret-change-me-please-32bytes
IDENTITY_SECURE_COOKIES=true
IDENTITY_MAIL_FROM=no-reply@dsacademy.edu.vn
IDENTITY_FRONTEND_RESET_URL=http://localhost:8090/reset-password

IDENTITY_DEFAULT_ADMIN_EMAIL=admin@eduerp.local
